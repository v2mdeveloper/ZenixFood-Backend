generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// SAAS CORE: MODELO DE LOJAS (TENANTS)

model Store {
  id                   String    @id @default(uuid())
  name                 String
  documentCnpj         String?   @unique
  email                String?   @unique
  phone                String?
  
  // 🧩 MÓDULOS CONTRATADOS (O que o lojista tem direito de usar)
  activeDelivery       Boolean   @default(true)
  activeTotem          Boolean   @default(false)
  activeKds            Boolean   @default(false)
  activeFiscal         Boolean   @default(false)

  // 💰 GESTÃO DE ASSINATURA (SaaS)
  monthlyFee           Float     @default(0.00)
  subscriptionStatus   String    @default("TRIAL") // TRIAL, ACTIVE, OVERDUE, BLOCKED
  subscriptionDueDate  DateTime? 
  
  // 🔑 CHAVES DE INTEGRAÇÃO INDIVIDUAIS
  mpPublicKey          String?   // Mercado Pago Front
  mpAccessToken        String?   // Mercado Pago Back
  focusEnv             String    @default("homologacao") // homologacao ou producao
  focusToken           String?   // Token da Focus NFe da loja
  
  // ⚙️ CONFIGURAÇÕES DA LOJA
  deliveryFee          Float     @default(0.00)
  cashbackPercent      Float     @default(0.00)
  isManualFechado      Boolean   @default(false)
  youtubeLiveId        String?
  aboutUsText          String?
  promoBannerUrl       String?
  promoBannerLink      String?
  schedule             Json?     // Agenda de funcionamento

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // 🔗 RELACIONAMENTOS REVERSOS (Tudo o que pertence a esta loja)
  users         User[]
  categories    Category[]
  products      Product[]
  productGroups ProductGroup[]
  orders        Order[]
  systemConfigs SystemConfig[]
  avaliacoes    Avaliacao[]
  insumos       Insumo[]
  settings      Settings[]
  fiscalConfigs FiscalConfig[]
  receitas      Receita[]
  profiles      AccessProfile[]
  employees     Employee[]
  shifts        Shift[]
  tabs          RestaurantTab[]
  printers      Printer[]
}

enum Role {
  CLIENT
  ADMIN
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  IN_TRANSIT
  DELIVERED
  CANCELED
}

// =================================================================
// MODELOS DE DADOS (ISOLADOS POR LOJA)
// =================================================================

model User {
  id               String   @id @default(uuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id])
  
  name             String
  email            String   
  password         String
  phone            String?
  cpf              String?  
  birthDate        String?  
  address          String?  
  role             Role     @default(CLIENT)
  isBlocked        Boolean  @default(false)
  resetCode        String?
  resetCodeExpires DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cashback         CashbackWallet?
  orders           Order[]
  accessLogs       AccessLog[]
  accountMovements CustomerAccountMovement[] 

  // SaaS: O mesmo email pode existir no banco, mas apenas uma vez por Loja
  @@unique([email, storeId])
}

model CustomerAccountMovement {
  id          String   @id @default(uuid())
  customerId  String
  customer    User     @relation(fields: [customerId], references: [id])
  type        String   
  amount      Float
  description String
  isPaid      Boolean  @default(false)
  createdAt   DateTime @default(now())
  paidAt      DateTime?
}

model CashbackWallet {
  id        String   @id @default(uuid())
  balance   Decimal  @default(0.00)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])

  name      String
  slug      String    
  order     Int       @default(0) 
  isDrink   Boolean   @default(false)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // SaaS: O mesmo slug pode existir em lojas diferentes
  @@unique([slug, storeId])
}

model Product {
  id            String         @id @default(uuid())
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id])

  name          String
  description   String?
  price         Decimal        @db.Decimal(10, 2)
  price700g     Decimal?       @db.Decimal(10, 2)
  price1kg      Decimal?       @db.Decimal(10, 2)
  costPrice     Float          @default(0)
  imageUrl      String?
  isActive      Boolean        @default(true)
  isFeatured    Boolean        @default(false)
  categoryId    String
  order         Int            @default(0)
  category      Category       @relation(fields: [categoryId], references: [id])
  items         OrderItem[]
  tabItems      TabItem[]      
  ncm           String?  
  ean           String?  
  regraFiscalId String?  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  fichasTecnicas FichaTecnica[]
  groupId       String?
  group         ProductGroup?  @relation(fields: [groupId], references: [id])
}

model ProductGroup {
  id            String    @id @default(uuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id])

  name          String  
  printerId     String?
  regraFiscalId String?
  printer       Printer?  @relation(fields: [printerId], references: [id])
  products      Product[]
}

model Order {
  id                String      @id @default(uuid())
  storeId           String
  store             Store       @relation(fields: [storeId], references: [id])

  shortId           Int         @default(autoincrement())
  total             Decimal
  deliveryFee       Decimal     @default(0.00)
  cashbackUsed      Decimal     @default(0.00)
  cashbackGenerated Decimal     @default(0.00)
  couponCode        String?   
  couponDiscount    Decimal     @default(0.00)
  paymentMethod     String
  address           String
  status            OrderStatus @default(PENDING)
  clientId          String
  client            User        @relation(fields: [clientId], references: [id])
  items             OrderItem[]
  origin            String?     @default("APP") 
  shiftId           String?
  shift             Shift?      @relation(fields: [shiftId], references: [id])
  registerId        String?
  register          CashRegister? @relation(fields: [registerId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  nfceData          String?
  waiter            String?
  deliveryPersonId  String?
  deliveryPerson    Employee?   @relation(fields: [deliveryPersonId], references: [id])
}

model OrderItem {
  id        String  @id @default(uuid())
  quantity  Int
  price     Decimal
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model SystemConfig {
  id      String @id
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])
  data    String
}

model Avaliacao {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  clienteNome String
  nota        Int      
  comentario  String
  dataCriacao DateTime @default(now())
}

model Insumo {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])

  name       String   
  unit       String   
  stock      Float    @default(0) 
  cost       Float    @default(0) 
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  fichas     FichaTecnica[]
  movimentos MovimentacaoEstoque[]
}

model FichaTecnica {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  insumoId  String
  insumo    Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  quantity  Float    
  
  @@unique([productId, insumoId]) 
}

model MovimentacaoEstoque {
  id        String   @id @default(cuid())
  insumoId  String
  insumo    Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  type      String   
  quantity  Float
  reason    String?  
  xmlRef    String?  
  createdAt DateTime @default(now())
}

model Settings {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])

  isManualFechado Boolean  @default(false)
  deliveryFee     Float    @default(0)
  cashbackPercent Int      @default(0)
  schedule        Json?    
}

model FiscalConfig {
  id        String @id @default(cuid())
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id])

  icms      Json?  @default("[]")
  pisCofins Json?  @default("[]")
  regras    Json?  @default("[]")
}

model AccessLog {
  id        String   @id @default(uuid())
  ip        String?
  device    String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Receita {
  id           String   @id @default(uuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])

  nome         String
  ingredientes String   
  preparo      String
  criadoEm     DateTime @default(now())
}

model AccessProfile {
  id         String     @id @default(uuid())
  storeId    String
  store      Store      @relation(fields: [storeId], references: [id])

  name       String     
  permissions String     
  employees  Employee[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([name, storeId])
}

model Employee {
  id              String   @id @default(uuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])

  name            String
  cpf             String   
  age             String?
  address         String?
  email           String   
  phone           String?
  password        String
  role            String   
  profileId       String
  profile         AccessProfile @relation(fields: [profileId], references: [id])
  isActive        Boolean  @default(true)
  receivesTips    Boolean  @default(false) 
  creditLimit     Float    @default(0.0)    
  discountPercent Float    @default(0.0)    
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  facePhoto       String?  @db.Text  
  lastFaceLogin   DateTime?            

  logs             EmployeeLog[] 
  accountMovements EmployeeAccountMovement[] 
  deliveries       Order[]

  // SaaS: O mesmo CPF/Email pode trabalhar em restaurantes diferentes (ex: Entregador/Freelancer)
  @@unique([cpf, storeId])
  @@unique([email, storeId])
}

model EmployeeAccountMovement {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  type        String   
  amount      Float
  description String
  isPaid      Boolean  @default(false)
  createdAt   DateTime @default(now())
  paidAt      DateTime?
}

model EmployeeLog {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  action     String   
  details    String?  
  createdAt  DateTime @default(now())
}

model Shift {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])

  openedAt  DateTime @default(now())
  closedAt  DateTime?
  status    String   @default("OPEN") 
  openedBy  String?  
  closedBy  String?
  registers CashRegister[]
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CashRegister {
  id             String         @id @default(uuid())
  shiftId        String
  shift          Shift          @relation(fields: [shiftId], references: [id])
  openedBy       String         
  closedBy       String?
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
  status         String         @default("OPEN") 
  openingBalance Float          @default(0.0) 
  closingBalance Float?
  closingDetails String?        
  movements      CashMovement[]
  orders         Order[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model CashMovement {
  id           String       @id @default(uuid())
  registerId   String
  register     CashRegister @relation(fields: [registerId], references: [id])
  type         String       
  amount       Float
  reason       String
  authorizedBy String       
  createdAt    DateTime     @default(now())
}

model RestaurantTab {
  id           String    @id @default(uuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id])

  number       Int       
  type         String    
  status       String    @default("OPEN") 
  customerName String?   
  customerCpf  String?
  parentTable  Int?      
  seatLabel    String?   
  openedBy     String    
  shiftId      String    
  linkedTable  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items        TabItem[]
}

model TabItem {
  id          String        @id @default(uuid())
  tabId       String
  tab         RestaurantTab @relation(fields: [tabId], references: [id])
  productId   String
  name        String
  price       Float
  quantity    Int
  observation String?
  seatLabel   String?        
  status      String        @default("PENDING") 
  createdAt   DateTime      @default(now())
  product     Product       @relation(fields: [productId], references: [id]) 
}

model Printer {
  id        String         @id @default(uuid())
  storeId   String
  store     Store          @relation(fields: [storeId], references: [id])

  name      String
  type      String         @default("USB") 
  address   String         
  groups    ProductGroup[]
}