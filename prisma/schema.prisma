generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Loja {
  id                 String   @id @default(uuid())
  slug               String   @unique // Ex: "burgerking" (usado para gerar burgerking.zenixfood.com.br)
  razaoSocial        String
  cnpj               String   @unique
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  endereco           String?
  emailEmpresa       String
  telefoneEmpresa    String
  regimeTributario   String?
  
  // Dados do Responsável pela Loja (Dono)
  nomeResponsavel    String
  cpfResponsavel     String
  emailResponsavel   String   @unique // Este será o e-mail de acesso master da loja
  senhaResponsavel   String   // Senha de acesso
  
  // Controle de Módulos SaaS (O que você vende para eles)
  isActive           Boolean  @default(true)
  modulosAtivos      Json     @default("[\"PDV\", \"KDS\", \"SALAO\"]") // Módulos que eles pagaram
  dataVencimento     DateTime?
  
  // Personalização White-Label da Loja (Totem/Cardápio)
  corPrincipal       String   @default("#F59E0B")
  logoUrl            String?
  cabecalhoHtml      String?
  rodapeHtml         String?
  
  // PLANOS E FINANCEIRO (Atualizado para o novo sistema)
  plan               String   @default("STANDARD") // Mantido por compatibilidade
  monthlyFee         Float    @default(0.0) // Valor final cobrado do cliente (Plano + Suporte)
  status             String   @default("ACTIVE")
  
  //Relacionamento com a Tabela de Planos Criados pelo Super Master
  planoSaaSId        String?
  planoSaaS          PlanoSaaS? @relation(fields: [planoSaaSId], references: [id])
  
  //Controle de Suporte Técnico do Franqueado
  temSuporte         Boolean  @default(false)
  valorSuporte       Float    @default(0.0) // Valor extra adicionado pelo Franqueado

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // RELACIONAMENTOS: Tudo no sistema agora "pertence" a uma loja.
  // O "Cascade" garante que, se você excluir a loja, todos os dados dela são apagados juntos.
  usuarios           User[]
  customerMovements  CustomerAccountMovement[]
  cashbackWallets    CashbackWallet[]
  categorias         Category[]
  produtos           Product[]
  productGroups      ProductGroup[]
  comboItems         ComboItem[] // Adicionado relacionamento para Combos
  orders             Order[]
  orderItems         OrderItem[]
  systemConfigs      SystemConfig[]
  avaliacoes         Avaliacao[]
  insumos            Insumo[]
  fichasTecnicas     FichaTecnica[]
  movimentacoes      MovimentacaoEstoque[]
  settings           Settings[]
  fiscalConfigs      FiscalConfig[]
  accessLogs         AccessLog[]
  receitas           Receita[]
  accessProfiles     AccessProfile[]
  employees          Employee[]
  employeeMovements  EmployeeAccountMovement[]
  employeeLogs       EmployeeLog[]
  shifts             Shift[]
  cashRegisters      CashRegister[]
  cashMovements      CashMovement[]
  restaurantTabs     RestaurantTab[]
  tabItems           TabItem[]
  printers           Printer[]
  contasPagas        ContaPagar[]
  
  // Relacionamento com o Franqueado (Dono da Carteira) e eventos, reservas
  adminUserId        String?
  adminUser          AdminUser? @relation(fields: [adminUserId], references: [id])
  eventos            EventoReserva[]
}

// ============================================================================
// Planos de Assinatura criados pelo Super Master
// ============================================================================

model PlanoSaaS {
  id          String   @id @default(uuid())
  nome        String   @unique // Ex: "Standard", "Premium"
  precoBase   Float    @default(0.0) // Preço mínimo definido pelo Super Master (Franqueado não muda isso)
  
  // Quais módulos este plano libera no painel do restaurante?
  // Ex: ["CARDAPIO", "PDV", "IMPRESSORAS", "KDS", "ESTOQUE", "FISCAL"]
  modulosLiberados Json @default("[]") 
  
  isActive    Boolean  @default(true)
  
  // Relacionamento: Quais lojas assinaram este plano?
  lojas       Loja[]   
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  CLIENT
  ADMIN
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  IN_TRANSIT
  DELIVERED
  CANCELED
}

model AdminUser {
  id           String   @id @default(uuid())
  name         String
  cpf          String?  @unique
  email        String   @unique
  password     String
  
  // Endereço
  cep          String?
  address      String?
  neighborhood String?
  city         String?
  uf           String?
  
  // Controle
  isActive     Boolean  @default(true)
  role         String   @default("MASTER") // Pode ser "SUPER_MASTER" ou "MASTER"
  
  // Relacionamento: Quais lojas este usuário gerencia?
  managedStores Loja[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

//ZENIXFOOD: TABELAS ADAPTADAS COM lojaId
model User {
  id               String          @id @default(uuid())
  lojaId           String
  loja             Loja            @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  
  name             String
  email            String          // Removido o @unique global
  password         String
  phone            String?
  cpf              String?        
  birthDate        String?    
  address          String?     
  role             Role            @default(CLIENT)
  isBlocked        Boolean         @default(false)
  resetCode        String?
  resetCodeExpires DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  
  cashback         CashbackWallet?
  orders           Order[]
  accessLogs       AccessLog[]
  accountMovements CustomerAccountMovement[] 

  @@unique([email, lojaId]) // O e-mail só precisa ser único DENTRO da mesma loja
}

model CustomerAccountMovement {
  id          String   @id @default(uuid())
  lojaId      String
  loja        Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  customerId  String
  customer    User     @relation(fields: [customerId], references: [id])
  type        String   
  amount      Float
  description String
  isPaid      Boolean  @default(false)
  createdAt   DateTime @default(now())
  paidAt      DateTime?
}

model CashbackWallet {
  id        String   @id @default(uuid())
  lojaId    String
  loja      Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0.00)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  lojaId    String
  loja      Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  name      String
  slug      String    // Removido o @unique global
  order     Int       @default(0) 
  isDrink   Boolean   @default(false) 
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([slug, lojaId]) // O slug de categoria é único por loja
}

model Product {
  id              String         @id @default(uuid())
  lojaId          String
  loja            Loja           @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Decimal        @db.Decimal(10, 2)
  price700g       Decimal?       @db.Decimal(10, 2)
  price1kg        Decimal?       @db.Decimal(10, 2)
  costPrice       Float          @default(0)
  imageUrl        String?
  isActive        Boolean        @default(true)
  isFeatured      Boolean        @default(false)
  categoryId      String
  order           Int            @default(0)
  category        Category       @relation(fields: [categoryId], references: [id])
  
  //Configurações de Pizza e Combo
  isPizza         Boolean        @default(false)
  maxFlavors      Int            @default(1)
  pricingStrategy String         @default("HIGHEST") // "HIGHEST" (Maior valor) ou "AVERAGE" (Média)
  sizeMultiplier  Float          @default(1.0)       // Multiplicador de estoque (Ex: Família = 1.3x)
  isCombo         Boolean        @default(false)

  //Árvore de Combos
  comboItemsAsParent ComboItem[]   @relation("ComboParent")
  comboItemsAsChild  ComboItem[]   @relation("ComboChild")

  items           OrderItem[]
  tabItems        TabItem[]      
  ncm             String?  
  ean             String?  
  regraFiscalId   String?  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  fichasTecnicas  FichaTecnica[]
  groupId         String?
  group           ProductGroup?  @relation(fields: [groupId], references: [id])
}

// Estrutura dos Combos Aninhados
model ComboItem {
  id        String  @id @default(uuid())
  lojaId    String
  loja      Loja    @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  comboId   String
  combo     Product @relation("ComboParent", fields: [comboId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation("ComboChild", fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([comboId, productId])
}

model ProductGroup {
  id            String    @id @default(uuid())
  lojaId        String
  loja          Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  name          String    
  printerId     String?
  regraFiscalId String?
  printer       Printer?  @relation(fields: [printerId], references: [id])
  products      Product[]
}

model Order {
  id                String      @id @default(uuid())
  lojaId            String
  loja              Loja        @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  shortId           Int         @default(autoincrement()) // Continua auto-increment global
  total             Decimal
  deliveryFee       Decimal     @default(0.00)
  cashbackUsed      Decimal     @default(0.00)
  cashbackGenerated Decimal     @default(0.00)
  couponCode        String?   
  couponDiscount    Decimal     @default(0.00)
  paymentMethod     String
  address           String
  status            OrderStatus @default(PENDING)
  clientId          String
  client            User        @relation(fields: [clientId], references: [id])
  items             OrderItem[]
  origin            String?     @default("APP") 
  shiftId           String?
  shift             Shift?      @relation(fields: [shiftId], references: [id])
  registerId        String?
  register          CashRegister? @relation(fields: [registerId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  nfceData          String?
  waiter            String?
  deliveryPersonId  String?
  deliveryPerson    Employee? @relation(fields: [deliveryPersonId], references: [id])
}

model OrderItem {
  id        String  @id @default(uuid())
  lojaId    String
  loja      Loja    @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  quantity  Int
  price     Decimal
  
  //Configuração do item na venda (Sabores e Bordas/Adicionais)
  flavors   Json?   // Guarda os sabores escolhidos [{ id: "123", name: "Calabresa" }]
  addons    Json?   // Guarda os adicionais ou bordas [{ insumoId: "123", quantity: 1, name: "Borda Catupiry" }]

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model SystemConfig {
  id      String @id @default(uuid()) // Transformado em UUID para suportar múltiplos
  lojaId  String
  loja    Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  key     String // "settings", "fiscal", "certificado_a1", etc.
  data    String

  @@unique([key, lojaId]) // A chave de configuração é única por Loja
}

model Avaliacao {
  id          String   @id @default(uuid())
  lojaId      String
  loja        Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  clienteNome String
  nota        Int      
  comentario  String
  dataCriacao DateTime @default(now())
}

model Insumo {
  id          String   @id @default(cuid())
  lojaId      String
  loja        Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  name        String   
  unit        String   
  stock       Float    @default(0) 
  cost        Float    @default(0) 
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  fichas      FichaTecnica[]
  movimentos  MovimentacaoEstoque[]
}

model FichaTecnica {
  id          String   @id @default(cuid())
  lojaId      String
  loja        Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  insumoId    String
  insumo      Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  quantity    Float    
  @@unique([productId, insumoId]) 
}

model MovimentacaoEstoque {
  id          String   @id @default(cuid())
  lojaId      String
  loja        Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  insumoId    String
  insumo      Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  type        String   
  quantity    Float
  reason      String?  
  xmlRef      String?  
  createdAt   DateTime @default(now())
}

model Settings {
  id              String   @id @default(cuid())
  lojaId          String
  loja            Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  isManualFechado Boolean  @default(false)
  deliveryFee     Float    @default(0)
  cashbackPercent Int      @default(0)
  schedule        Json?    
}

model FiscalConfig {
  id        String @id @default(cuid())
  lojaId    String
  loja      Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  icms      Json?  @default("[]")
  pisCofins Json?  @default("[]")
  regras    Json?  @default("[]")
}

model AccessLog {
  id        String   @id @default(uuid())
  lojaId    String
  loja      Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  ip        String?
  device    String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Receita {
  id           String   @id @default(uuid())
  lojaId       String
  loja         Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  nome         String
  ingredientes String   
  preparo      String
  criadoEm     DateTime @default(now())
}

model AccessProfile {
  id          String     @id @default(uuid())
  lojaId      String
  loja        Loja       @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  name        String     
  permissions String     
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([name, lojaId])
}

model Employee {
  id              String        @id @default(uuid())
  lojaId          String
  loja            Loja          @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  name            String
  cpf             String        
  age             String?
  address         String?
  email           String        
  phone           String?
  password        String
  role            String        
  profileId       String
  profile         AccessProfile @relation(fields: [profileId], references: [id])
  isActive        Boolean       @default(true)
  receivesTips    Boolean       @default(false) 
  creditLimit     Float         @default(0.0)    
  discountPercent Float         @default(0.0)    
  logs            EmployeeLog[] 
  accountMovements EmployeeAccountMovement[] 
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  facePhoto       String?       @db.Text  
  lastFaceLogin   DateTime?           
  deliveries      Order[]

  @@unique([cpf, lojaId])
  @@unique([email, lojaId])
}

model EmployeeAccountMovement {
  id          String   @id @default(uuid())
  lojaId      String
  loja        Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  type        String   
  amount      Float
  description String
  isPaid      Boolean  @default(false)
  createdAt   DateTime @default(now())
  paidAt      DateTime?
}

model EmployeeLog {
  id          String   @id @default(uuid())
  lojaId      String
  loja        Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  action      String   
  details     String?  
  createdAt   DateTime @default(now())
}

model Shift {
  id          String         @id @default(uuid())
  lojaId      String
  loja        Loja           @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  openedAt    DateTime       @default(now())
  closedAt    DateTime?
  status      String         @default("OPEN") 
  openedBy    String?        
  closedBy    String?
  registers   CashRegister[]
  orders      Order[]
  contasPagas ContaPagar[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model CashRegister {
  id             String         @id @default(uuid())
  lojaId         String
  loja           Loja           @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  shiftId        String
  shift          Shift          @relation(fields: [shiftId], references: [id])
  openedBy       String         
  closedBy       String?
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
  status         String         @default("OPEN") 
  openingBalance Float          @default(0.0) 
  closingBalance Float?
  closingDetails String?       
  movements      CashMovement[]
  orders         Order[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model CashMovement {
  id             String       @id @default(uuid())
  lojaId         String
  loja           Loja         @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  registerId     String
  register       CashRegister @relation(fields: [registerId], references: [id])
  type           String       
  amount         Float
  reason         String
  authorizedBy   String       
  createdAt      DateTime     @default(now())
}

model RestaurantTab {
  id           String    @id @default(uuid())
  lojaId       String
  loja         Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  number       Int       
  type         String    
  status       String    @default("OPEN") 
  customerName String?   
  customerCpf  String?
  parentTable  Int?      
  seatLabel    String?   
  openedBy     String    
  shiftId      String    
  items        TabItem[]
  createdAt    DateTime  @default(now())
  linkedTable  Int?
  updatedAt    DateTime  @updatedAt

  //NOVOS CAMPOS PARA EVENTOS E RECEPÇÃO AQUI DENTRO:
  eventoId        String?
  evento          EventoReserva?   @relation(fields: [eventoId], references: [id])
  
  // Vínculo 1-para-1: Esta comanda/mesa pertence a um convidado específico da lista?
  convidado       EventoConvidado?
}

model TabItem {
  id          String        @id @default(uuid())
  lojaId      String
  loja        Loja          @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  tabId       String
  tab         RestaurantTab @relation(fields: [tabId], references: [id])
  productId   String
  name        String
  price       Float
  quantity    Int
  observation String?
  seatLabel   String?       
  status      String        @default("PENDING") 
  createdAt   DateTime      @default(now())
  product     Product       @relation(fields: [productId], references: [id]) 
}

model Printer {
  id        String         @id @default(uuid())
  lojaId    String
  loja      Loja           @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  name      String
  type      String         @default("USB") 
  address   String         
  groups    ProductGroup[]
}

model ContaPagar {
  id              String    @id @default(uuid())
  lojaId          String
  loja            Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  descricao       String
  valor           Float
  dataVencimento  DateTime
  dataPagamento   DateTime?
  status          String    @default("PENDENTE") 
  metodoPagamento String?   
  fornecedor      String?   
  shiftId         String?
  shift           Shift?    @relation(fields: [shiftId], references: [id])
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ============================================================================
// MÓDULO DE RECEPÇÃO E EVENTOS
// ============================================================================

model EventoReserva {
  id              String   @id @default(uuid())
  nome            String   // Ex: "Confraternização TechCorp", "Aniversário do João"
  
  // Define o comportamento do evento
  tipo            String   @default("MISTO") // "APENAS_MESAS", "APENAS_COMANDAS", "MISTO"
  status          String   @default("AGENDADO") // AGENDADO, EM_ANDAMENTO, FINALIZADO, CANCELADO
  
  dataHoraInicio  DateTime
  dataHoraFim     DateTime?
  qtdPessoas      Int      @default(1)
  observacoes     String?  // Ex: "Trazer bolo de surpresa às 22h"

  // Vínculo Obrigatório com a Loja
  lojaId          String
  loja            Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  // Lista de Convidados importada do Excel/CSV
  convidados      EventoConvidado[]

  // Mesas e Comandas que já estão fisicamente abertas no Salão para este evento
  tabsAtivas      RestaurantTab[] 

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EventoConvidado {
  id              String   @id @default(uuid())
  nome            String
  cpf             String?
  email           String?
  telefone        String?
  
  // Controle da Porta (Hostess)
  statusCheckIn   Boolean  @default(false)
  horaCheckIn     DateTime?
  
  // Planejamento (O que veio da planilha)
  mesaIndicada    String?  // Ex: "10" (Pode ser vazio se for só comanda)
  posicaoMesa     String?  // Ex: "Lugar 2"
  comandaIndicada String?  // Ex: "2001" (Pode ser vazio se for só reserva de mesa)
  
  // Vínculos
  eventoId        String
  evento          EventoReserva @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  // Quando ele chega e faz check-in, a comanda/mesa virtual vira uma TAB real no salão
  tabId           String?       @unique 
  tab             RestaurantTab? @relation(fields: [tabId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}